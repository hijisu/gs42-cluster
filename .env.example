# 이 파일을 .env 로 복사해서 사용한다. .env 는 커밋하지 않는다.
# 새 환경변수를 추가하면 이 파일과 docs/BUILD.md 의 환경변수 표를 함께 갱신한다.

# ── docker compose (개발) ───────────────────────────
# 한 PC에서 클론/에이전트를 여러 개 돌릴 때만 서로 다르게 바꾼다.
COMPOSE_PROJECT_NAME=gs42
# 호스트에서 접속하는 포트(컨테이너 안 포트는 고정: db 5432, backend 8000, frontend 5173)
DB_HOST_PORT=5432
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173

# ── Django ──────────────────────────────────────────
DJANGO_SECRET_KEY=change-me
# 운영에서는 false. true일 때만 모의 로그인을 허용한다.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Seoul

# ── Database (PostgreSQL) ───────────────────────────
POSTGRES_DB=gs42
POSTGRES_USER=gs42
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── 42 OAuth (intra 앱 등록 후 입력) ────────────────
FORTYTWO_UID=
FORTYTWO_SECRET=
FORTYTWO_REDIRECT_URI=http://localhost:8000/api/auth/callback

# ── 권한 ────────────────────────────────────────────
# 교육운영팀 intra login, 쉼표로 구분
STAFF_INTRA_IDS=

# ── Frontend ────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=/api

# ── Web Push (Phase 2, #25) ─────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ── Slack (Phase 3, #33) ────────────────────────────
SLACK_BOT_TOKEN=
