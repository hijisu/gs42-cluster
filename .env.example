# 이 파일을 .env 로 복사해서 사용한다. .env 는 커밋하지 않는다.
# 새 환경변수를 추가하면 이 파일과 docs/BUILD.md 의 환경변수 표를 함께 갱신한다.

# ── docker compose (개발) ───────────────────────────
# 한 PC에서 클론/에이전트를 여러 개 돌릴 때만 서로 다르게 바꾼다. 개발용 docker-compose.yml 에만 적용된다.
# (운영 구성 docker-compose.prod.yml 은 이 값보다 `-p <이름>-prod` 로 프로젝트를 따로 지정한다. BUILD.md 참고)
COMPOSE_PROJECT_NAME=gs42
# 호스트에 여는 서비스 포트는 리버스 프록시(web) 하나뿐이다. http://<FRONTEND_PUBLIC_HOST>:<FRONTEND_HOST_PORT> 로 접속한다.
# 백엔드·프론트 개발 서버·DB 는 호스트에 열리지 않는다(DB 는 backend 전용 내부 네트워크).
# FRONTEND_HOST_PORT 를 바꾸면 compose 가 FRONTEND_ORIGIN(CSRF·CORS)과 42 redirect URI 를 자동으로 맞춘다(intra 앱에 등록한 값도 같게).
FRONTEND_HOST_PORT=5173
# 프록시 포트를 여는 주소. 0.0.0.0 = 같은 네트워크의 다른 기기(PC·휴대폰)에서도 접속 가능, 이 PC에서만 쓰려면 127.0.0.1.
# 주의: 개발 모드는 모의 로그인이 켜져 있어 그 네트워크의 누구나 운영팀 계정으로 들어올 수 있다(공용 와이파이 금지).
FRONTEND_BIND=0.0.0.0
# 브라우저가 접속하는 호스트(이름 또는 IP). 다른 기기에서 42 로그인까지 쓰려면 이 PC의 IP 로 바꾸고 intra 앱에 그 주소의 redirect URI 를 등록한다.
FRONTEND_PUBLIC_HOST=localhost
# 컨테이너 안에서 각 서비스가 듣는 포트(보통 바꿀 필요 없음). web=프록시, backend=Django, frontend=Vite 개발 서버.
WEB_PORT=80
BACKEND_PORT=8000
FRONTEND_PORT=5173
# (선택) 호스트에서 백엔드를 직접 실행할 때만: docker-compose.db-host.yml 로 DB 를 이 PC 루프백의 이 포트에 연다.
DB_HOST_PORT=5432
# 호스트에서 `npm run dev` 로 프론트만 실행할 때 /api 프록시 대상(셸 환경변수로 지정, 기본값 http://localhost:8000).
# compose 의 frontend 서비스는 BACKEND_PORT 로 계산한 http://backend:<포트> 를 쓰므로 이 값을 쓰지 않는다.
# API_PROXY_TARGET=http://localhost:8000

# 운영 구성 로컬 검증(docker-compose.prod.yml)이 호스트에 여는 HTTP 포트. http://localhost:<포트> 로 접속한다.
PROD_HTTP_PORT=80
# 운영 구성 backend(gunicorn)의 워커 프로세스 수
GUNICORN_WORKERS=2

# ── Django ──────────────────────────────────────────
# 운영(DJANGO_DEBUG=false)에서는 예시 값 change-me 로 기동하지 않는다. 생성: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
# 운영에서는 false. true일 때만 모의 로그인을 허용한다.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Secure 쿠키. 기본은 DJANGO_DEBUG=false 일 때 true. http://localhost 로 운영 구성을 검증할 때만 false
# (docker-compose.prod.yml 이 backend 에 false 로 지정한다). HTTPS 로 실제 배포할 때는 지정하지 않는다.
# DJANGO_COOKIE_SECURE=false
TIME_ZONE=Asia/Seoul

# ── Database (PostgreSQL) ───────────────────────────
POSTGRES_DB=gs42
POSTGRES_USER=gs42
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── 42 OAuth (intra 앱 등록 후 입력) ────────────────
FORTYTWO_UID=
FORTYTWO_SECRET=
# 42 intra 앱에 등록한 redirect URI 와 정확히 같아야 한다. compose 에서는 비워 두면
# http://<FRONTEND_PUBLIC_HOST>:<FRONTEND_HOST_PORT>/api/auth/callback 으로 자동 계산된다(프록시 경유).
# 호스트에서 backend 를 직접 실행(runserver 8000)할 때는 http://localhost:8000/api/auth/callback 을 쓴다.
FORTYTWO_REDIRECT_URI=http://localhost:5173/api/auth/callback

# ── 권한 ────────────────────────────────────────────
# 교육운영팀 intra login, 쉼표로 구분
STAFF_INTRA_IDS=

# ── Frontend ────────────────────────────────────────
# 호스트에서 직접 실행할 때의 프론트 주소. docker compose 에서는 FRONTEND_HOST_PORT 로 자동 계산되어 무시된다.
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=/api

# ── Web Push (Phase 2, #25) ─────────────────────────
# 키가 없으면 웹 푸시는 꺼지고 앱 안 알림만 동작한다. 생성: python manage.py generate_vapid_keys
# (docker: docker compose exec backend python manage.py generate_vapid_keys) → 출력된 두 줄을 아래에 붙여 넣는다.
# VAPID_PRIVATE_KEY 는 비밀값이다. 커밋·채팅·이슈에 붙여 넣지 않는다. VAPID_PUBLIC_KEY 는 개인키에서 서버가 계산하므로 참고용이다.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 푸시 서비스가 문제 발생 시 연락할 주소(mailto: 또는 https URL)
VAPID_SUBJECT=mailto:admin@example.com

# ── Slack (Phase 3, #33) ────────────────────────────
SLACK_BOT_TOKEN=
