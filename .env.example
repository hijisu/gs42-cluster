# 이 파일을 .env 로 복사해서 사용한다. .env 는 커밋하지 않는다.
# 새 환경변수를 추가하면 이 파일과 docs/BUILD.md 의 환경변수 표를 함께 갱신한다.

# ── docker compose (개발) ───────────────────────────
# 한 PC에서 클론/에이전트를 여러 개 돌릴 때만 서로 다르게 바꾼다. 개발용 docker-compose.yml 에만 적용된다.
# (운영 구성 docker-compose.prod.yml 은 이 값보다 `-p <이름>-prod` 로 프로젝트를 따로 지정한다. BUILD.md 참고)
COMPOSE_PROJECT_NAME=gs42
# 호스트에서 접속하는 포트(컨테이너 안 포트는 고정: db 5432, backend 8000, frontend 5173)
# FRONTEND_HOST_PORT 를 바꾸면 compose 가 FRONTEND_ORIGIN(CSRF·CORS)을 자동으로 맞춘다.
# BACKEND_HOST_PORT 를 바꾸면 아래 FORTYTWO_REDIRECT_URI 와 intra 앱에 등록한 redirect URI 도 같은 포트로 맞춘다.
DB_HOST_PORT=5432
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
# 호스트에서 `npm run dev` 로 프론트만 실행할 때 /api 프록시 대상(셸 환경변수로 지정, 기본값 http://localhost:8000).
# compose 의 frontend 서비스는 http://backend:8000 으로 고정되어 있어 이 값을 쓰지 않는다.
# API_PROXY_TARGET=http://localhost:8000

# 운영 구성 로컬 검증(docker-compose.prod.yml)이 호스트에 여는 HTTP 포트. http://localhost:<포트> 로 접속한다.
PROD_HTTP_PORT=80
# 운영 구성 backend(gunicorn)의 워커 프로세스 수
GUNICORN_WORKERS=2

# ── Django ──────────────────────────────────────────
# 운영(DJANGO_DEBUG=false)에서는 예시 값 change-me 로 기동하지 않는다. 생성: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
# 운영에서는 false. true일 때만 모의 로그인을 허용한다.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Secure 쿠키. 기본은 DJANGO_DEBUG=false 일 때 true. http://localhost 로 운영 구성을 검증할 때만 false
# (docker-compose.prod.yml 이 backend 에 false 로 지정한다). HTTPS 로 실제 배포할 때는 지정하지 않는다.
# DJANGO_COOKIE_SECURE=false
TIME_ZONE=Asia/Seoul

# ── Database (PostgreSQL) ───────────────────────────
POSTGRES_DB=gs42
POSTGRES_USER=gs42
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── 42 OAuth (intra 앱 등록 후 입력) ────────────────
FORTYTWO_UID=
FORTYTWO_SECRET=
# 42 intra 앱에 등록한 redirect URI 와 정확히 같아야 한다(BACKEND_HOST_PORT 를 바꾸면 함께 바꾼다).
FORTYTWO_REDIRECT_URI=http://localhost:8000/api/auth/callback

# ── 권한 ────────────────────────────────────────────
# 교육운영팀 intra login, 쉼표로 구분
STAFF_INTRA_IDS=

# ── Frontend ────────────────────────────────────────
# 호스트에서 직접 실행할 때의 프론트 주소. docker compose 에서는 FRONTEND_HOST_PORT 로 자동 계산되어 무시된다.
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=/api

# ── Web Push (Phase 2, #25) ─────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ── Slack (Phase 3, #33) ────────────────────────────
SLACK_BOT_TOKEN=
